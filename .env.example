# UES Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# OpenWeatherMap API (optional - for real weather data)
# =============================================================================
# Get your API key from: https://openweathermap.org/api
# OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# LLM Provider API Keys (for AgentBeats response generation)
# =============================================================================

# OpenAI API Key (required for OpenAIProvider)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic API Key (required for AnthropicProvider)
# Get your API key from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# =============================================================================
# Access Control (optional - for AgentBeats proctor/user key enforcement)
# =============================================================================
# Set to 'true' to enable API key-based access control
# UES_ACCESS_CONTROL=false
